# Copy to .env and set real values before deploying:  cp .env.example .env
# docker-compose reads these automatically.

# --- Database (reachable only on the internal docker network) ---
DB_PASSWORD=change-this-strong-db-password

# --- Application admin bootstrap ---
# On a fresh database a single "admin" user is created with this password.
# If left empty, a strong random password is generated and printed once in `docker compose logs api`.
APP_ADMIN_PASSWORD=change-this-strong-admin-password

# Demo mode ONLY: seed weak users admin/editor/viewer (admin123 …). Leave false for real use.
AUTH_SEED_DEFAULTS=false

# --- CORS / origins (restrict to your web origin in production, e.g. https://plan.example.com) ---
APP_ALLOWED_ORIGINS=*
APP_WS_ALLOWED_ORIGINS=*

# --- Analytics ---
# Require the same bearer token as the Java API for /analytics data endpoints.
ANALYTICS_AUTH_ENABLED=true

# --- Optional integrations (leave empty to disable) ---
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
